<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">
    <EditText
        android:id="@+id/editHistorySearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/e_search_hint"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:singleLine="true" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Spinner
            android:id="@+id/spinnerHistoryType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:contentDescription="@string/e_type"
            android:prompt="@string/e_type" />
        <Spinner
            android:id="@+id/spinnerHistoryCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:contentDescription="@string/e_category"
            android:prompt="@string/e_category" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Spinner
            android:id="@+id/spinnerHistoryMember"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:contentDescription="@string/e_member"
            android:prompt="@string/e_member" />
        <Spinner
            android:id="@+id/spinnerHistorySort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:contentDescription="@string/e_sort"
            android:prompt="@string/e_sort" />
    </LinearLayout>
    <TextView
        android:id="@+id/textHistoryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/e_loading_history" />
    <Button
        android:id="@+id/buttonHistoryRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/e_retry"
        android:visibility="gone" />
</LinearLayout>
