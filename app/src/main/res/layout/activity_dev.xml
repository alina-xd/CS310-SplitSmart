<?xml version="1.0" encoding="utf-8"?>
<!-- Developer tools. Development only: remove before the demo. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Developer tools"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:id="@+id/textDevCurrentUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonDevSeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seed / reset test data" />

    <Button
        android:id="@+id/buttonDevAlice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Act as Alice" />

    <Button
        android:id="@+id/buttonDevBob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Act as Bob" />

    <Button
        android:id="@+id/buttonDevCarol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Act as Carol" />

    <Button
        android:id="@+id/buttonDevDavid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Act as David" />

    <Button
        android:id="@+id/buttonDevTrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Trip group" />

    <Button
        android:id="@+id/buttonDevHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Apartment group" />

    <Button
        android:id="@+id/buttonDevDisposable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Disposable group" />

    <Button
        android:id="@+id/buttonDevGroupList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open group list" />

    </LinearLayout>
</ScrollView>
