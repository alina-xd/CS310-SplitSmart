<?xml version="1.0" encoding="utf-8"?>
<!-- Owner: Part C. Included in activity_expense_form.xml (Part B). Rows are added in code by ExpenseSplitSection. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionExpenseSplit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/split_method_label"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <RadioGroup
        android:id="@+id/radioSplitMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@+id/radioSplitEqual"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioSplitEqual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/split_equal" />

        <RadioButton
            android:id="@+id/radioSplitExact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/split_exact" />

        <RadioButton
            android:id="@+id/radioSplitPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/split_percent" />
    </RadioGroup>

    <!-- One row per participant: name, input (hidden for Equal), computed share. -->
    <LinearLayout
        android:id="@+id/splitRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/textSplitStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
