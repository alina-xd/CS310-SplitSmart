<?xml version="1.0" encoding="utf-8"?>
<!-- Part E: scrollable full details, including every participant's share. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/e_details"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <TextView
            android:id="@+id/textTransactionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/e_loading_details" />
        <Button
            android:id="@+id/buttonDetailRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/e_retry"
            android:visibility="gone" />
        <TextView
            android:id="@+id/textTransactionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="8dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textIsSelectable="true" />
        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/e_edit"
            android:visibility="gone" />
        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/e_delete"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
