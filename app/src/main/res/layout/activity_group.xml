<?xml version="1.0" encoding="utf-8"?>
<!-- Shared shell for the group screen; nobody needs to edit it. Sections: Part A (members), Part E (history). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:id="@+id/groupOverview" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:text="Group" />

    <Button
        android:id="@+id/buttonAddExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add expense" />

    <Button
        android:id="@+id/buttonRecordSettlement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record settlement" />

    <Button
        android:id="@+id/buttonBalances"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Balances" />

    <Button
        android:id="@+id/buttonMonthlySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Monthly summary" />

    <include
        layout="@layout/section_group_members"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    </LinearLayout>

    <include
        layout="@layout/section_group_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
