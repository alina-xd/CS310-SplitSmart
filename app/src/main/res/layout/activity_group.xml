<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder screen. Owner: Features 1 and 5. Replace the contents freely. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Group"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Placeholder screen (Features 1 and 5)" />

    <Button
        android:id="@+id/buttonAddExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add expense" />

    <Button
        android:id="@+id/buttonRecordSettlement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record settlement" />

    <Button
        android:id="@+id/buttonBalances"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Balances" />

    <Button
        android:id="@+id/buttonMonthlySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Monthly summary" />

    <Button
        android:id="@+id/buttonEditGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit group" />

    <Button
        android:id="@+id/buttonAddMember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add member" />

    <Button
        android:id="@+id/buttonDeleteGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete group" />

    <Button
        android:id="@+id/buttonOpenTransactionPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open a transaction (placeholder)" />

</LinearLayout>
